# Public values are bundled at build time; never place secrets here.
VITE_APP_NAME=Web Foundation
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000
VITE_ENABLE_MOCKS=false
VITE_DEFAULT_LOCALE=vi
VITE_TIME_ZONE=UTC
VITE_ENABLE_PROJECT_DELETE=true
# Feature switches control presentation only; the backend must enforce permissions.
# Same-origin /api expects a gateway. dev:api does not create a proxy automatically.
# Production overrides belong in .env.production.local or CI environment variables.
# See README.md for memory access tokens and backend-owned HttpOnly cookies.
