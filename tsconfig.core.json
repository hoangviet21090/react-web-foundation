{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo"
  },
  "include": [
    "src/features/*/domain/**/*.ts",
    "src/features/*/application/**/*.ts",
    "src/shared/domain/**/*.ts",
    "src/shared/application/**/*.ts"
  ],
  "exclude": ["**/*.test.*", "**/*.spec.*"]
}
